/*
 * TEMPORARY test shield: the temper's LEFT half standing in as the pacino's left half, i.e. a
 * peripheral for a pacino right half running as the central (config/pacino_right.conf).
 *
 * Hardware is the temper left (same kscan pins); the matrix transform uses the PACINO's position
 * numbering, so this half's keys land on the pacino keymap's left-half positions: letters on
 * 0-4 / 10-14 / 20-24 and the three thumbs on 34-36. The pacino positions this half does not
 * have (the right half and the four extras) point at matrix slots that never fire here.
 *
 * Bring-up:
 *   1. flash settings_reset on the temper left first (it was the temper's central, it holds bonds),
 *   2. flash this firmware on it,
 *   3. power it next to the pacino right central; they find and bond each other automatically.
 *
 * Giving the half back to the temper later: settings_reset BOTH temper halves and reflash them
 * (the temper right is bonded to the old left-central identity), then delete this shield,
 * config/temper_pacino.conf and its build.yaml entry.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)      RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)      RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)      RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
        RC(3,0) RC(3,1)                              RC(3,5) RC(3,6)
                RC(3,2) RC(3,3) RC(3,4)      RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&pro_micro 21 GPIO_ACTIVE_HIGH>
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>
            ;
    };
};
